<%@ page pageEncoding="UTF-8" %>
<%@ page contentType="text/html; charset=UTF-8" %>
<%@ page import="java.util.List,java.util.Map,io.github.gavinruff007.torchnode.security.AuthStore,io.github.gavinruff007.torchnode.security.AuthFilter" %>
<%! private String h(Object value){return AuthFilter.html(value);} %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Administration · TorchNode</title><style>section{background:#111b2b;border:1px solid #293a51;border-radius:12px;padding:22px;margin:20px 0}form{display:flex;flex-wrap:wrap;gap:12px;align-items:end}label{display:grid;gap:8px;font-size:13px;color:#b6c8dd}input,select,button{padding:10px;background:#0c1422;color:#e6efff;border:1px solid #415774;border-radius:6px}button{cursor:pointer;background:#235e62}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:12px;border-bottom:1px solid #293a51}.table-scroll{overflow:auto}p{color:#b4c8df;line-height:1.6}</style></head><body><%@ include file="layout.jsp" %><main class="shell">
<% if("/settings".equals(request.getServletPath())) { %>
<h1>Settings & collection controls</h1><section><h2>Scan lifecycle</h2><p>Start or stop collection from this vantage point. Existing inspection safety limits remain in force.</p><form method="post" action="/scanner/start"><input type="hidden" name="csrf" value="<%=h(request.getAttribute("csrfToken"))%>"><button>Start scan</button></form><form method="post" action="/scanner/stop"><input type="hidden" name="csrf" value="<%=h(request.getAttribute("csrfToken"))%>"><button>Stop scan</button></form></section><section><h2>Security policy</h2><p>Argon2id passwords · 30 minute idle / 8 hour absolute sessions · API requires a signed-in ADMIN or VIEWER · exports require ADMIN. Password resets and account disabling revoke existing sessions.</p><p>Binding, TLS termination, offline GeoIP paths and helper configuration are deployment settings. See docs/security-and-analytics.md in the project.</p><a href="/admin/users">Manage authorized users and view audit events</a></section>
<% } else { %>
<h1>User management</h1><p role="alert"><%=h(request.getAttribute("adminMessage"))%></p><section><h2>Create authorized user</h2><form method="post" action="/admin/users"><input type="hidden" name="csrf" value="<%=h(request.getAttribute("csrfToken"))%>"><input type="hidden" name="action" value="create"><label>Username or email<input name="username" required maxlength="128" autocomplete="off"></label><label>Initial password<input name="password" type="password" required minlength="12" maxlength="256" autocomplete="new-password"></label><label>Role<select name="role"><option>VIEWER</option><option>ADMIN</option></select></label><button>Create user</button></form></section>
<section><h2>Authorized users</h2><div class="table-scroll"><table><thead><tr><th>Username</th><th>Role</th><th>State</th><th>Update account / reset password</th></tr></thead><tbody>
<% for(var u:(List<AuthStore.User>)request.getAttribute("users")){ %><tr><td><%=h(u.username())%></td><td><%=h(u.role())%></td><td><%=u.enabled()?"Enabled":"Disabled"%></td><td><form method="post" action="/admin/users"><input type="hidden" name="csrf" value="<%=h(request.getAttribute("csrfToken"))%>"><input type="hidden" name="action" value="update"><input type="hidden" name="username" value="<%=h(u.username())%>"><label>Role<select name="role"><option <%=u.role().equals("VIEWER")?"selected":""%>>VIEWER</option><option <%=u.role().equals("ADMIN")?"selected":""%>>ADMIN</option></select></label><label>Access<select name="enabled"><option value="true">Enabled</option><option value="false" <%=!u.enabled()?"selected":""%>>Disabled</option></select></label><label>New password (optional)<input name="password" type="password" minlength="12" maxlength="256" autocomplete="new-password"></label><button>Save / revoke sessions</button></form></td></tr><% } %></tbody></table></div></section>
<section><h2>Authentication audit · latest 100 events</h2><p>UTC server timestamps. Audit records survive clearing collected observations.</p><div class="table-scroll"><table><thead><tr><th>UTC timestamp</th><th>Actor</th><th>Event</th><th>Remote address</th></tr></thead><tbody><% for(var row:(List<Map<String,Object>>)request.getAttribute("auditEvents")){ %><tr><td><%=h(row.get("timestamp"))%></td><td><%=h(row.get("actor"))%></td><td><%=h(row.get("event"))%></td><td><%=h(row.get("remote"))%></td></tr><% } %></tbody></table></div></section><% } %></main></body></html>
